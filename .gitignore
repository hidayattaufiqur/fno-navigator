# Node modules
node_modules/

# Build / output
/build/
/dist/
/.svelte-kit/
.vite/
/.cache/

# Vite / SvelteKit build outputs
/build/_app/
/.svelte-kit/output/

# Environment files (local secrets)
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Local artifacts and logs
.artifacts-*/
*.log
*.local

# Editor directories
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage
coverage/
.nyc_output/

# Database
*.sqlite
*.db

# Keys and certs
*.pem
*.key
*.crt

# Playwright / test artifacts
playwright-report/
storage-state.json
tests/.scratch/
tests/.evidence/
.playwright/

# Local-only tooling / private assistant metadata
.claude/
.github/copilot-instructions.md
REVIEWING.md

# Agent-generated dev artifacts (screenshots, probes, audits)
artifacts/
tests/*.mjs
.janus-evidence/
.r2-evidence/
.r3-evidence/

# Ignore build artifacts created by SvelteKit / adapter
/.svelte-kit/
/.svelte-kit/output/

# Large static assets that should not be committed
/static/fonts/
